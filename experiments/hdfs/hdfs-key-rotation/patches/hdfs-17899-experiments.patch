+package org.apache.hadoop.hdfs.server.datanode;
+
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+import java.io.IOException;
+import java.util.List;
+
+import org.apache.hadoop.fs.FSDataInputStream;
+import org.apache.hadoop.fs.Path;
+import org.apache.hadoop.fs.StorageType;
+import org.apache.hadoop.hdfs.DFSTestUtil;
+import org.apache.hadoop.hdfs.DistributedFileSystem;
+import org.apache.hadoop.hdfs.HdfsConfiguration;
+import org.apache.hadoop.hdfs.MiniDFSCluster;
+import org.apache.hadoop.hdfs.protocol.DatanodeInfo;
+import org.apache.hadoop.hdfs.protocol.DatanodeInfo.DatanodeInfoBuilder;
+import org.apache.hadoop.hdfs.protocol.ExtendedBlock;
+import org.apache.hadoop.hdfs.protocol.LocatedBlock;
+import org.apache.hadoop.hdfs.security.token.block.BlockTokenSecretManager;
+import org.apache.hadoop.hdfs.security.token.block.ExportedBlockKeys;
+import org.apache.hadoop.hdfs.server.blockmanagement.DatanodeDescriptor;
+import org.apache.hadoop.test.GenericTestUtils;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.Timeout;
+
+/** End-to-end workload for the DataNode.DataTransfer variant of HDFS-17899. */
+@Timeout(90)
+public class TestCausynthDataTransferRpcFailure {
+
+  private static final Path FILE = new Path("/causynth-data-transfer");
+
+  @Test
+  public void testReplicationAfterModeledKeyRefreshRpcFailure()
+      throws Exception {
+    HdfsConfiguration conf = new HdfsConfiguration();
+    conf.setBoolean("dfs.encrypt.data.transfer", true);
+    conf.setBoolean("dfs.block.access.token.enable", true);
+    conf.setBoolean("dfs.test.causynth.data-transfer.rpc-failure", true);
+
+    MiniDFSCluster cluster = null;
+    DistributedFileSystem fs = null;
+    try {
+      cluster = new MiniDFSCluster.Builder(conf).numDataNodes(2).build();
+      cluster.waitActive();
+      fs = cluster.getFileSystem();
+      DFSTestUtil.createFile(fs, FILE, 1024, (short) 1, 0x17899L);
+      DFSTestUtil.waitReplication(fs, FILE, (short) 1);
+
+      LocatedBlock located;
+      try (FSDataInputStream in = fs.open(FILE)) {
+        located = DFSTestUtil.getAllBlocks(in).get(0);
+      }
+      ExtendedBlock block = located.getBlock();
+      DataNode source = cluster.getDataNode(
+          located.getLocations()[0].getIpcPort());
+      assertNotNull(source);
+      DataNode target = otherDataNode(cluster.getDataNodes(), source);
+      assertNotNull(target);
+
+      BlockTokenSecretManager master = cluster.getNamesystem()
+          .getBlockManager().getBlockTokenSecretManager();
+      master.clearAllKeysForTesting();
+      master.updateKeys(Long.MAX_VALUE);
+      master.clearAllKeysForTesting();
+      master.updateKeys(Long.MAX_VALUE);
+      ExportedBlockKeys latest = master.exportKeys();
+      String blockPoolId = block.getBlockPoolId();
+
+      BlockTokenSecretManager targetKeys = target
+          .getBlockPoolTokenSecretManager().get(blockPoolId);
+      targetKeys.clearAllKeysForTesting();
+      targetKeys.addKeys(latest);
+
+      // Ask the NameNode to send one real KeyUpdateCommand in the source
+      // DataNode's next heartbeat response.  BPOfferService applies that
+      // command on its command-processing thread.  The concrete seed applies
+      // S2; the symbolic failure case catches IOException and retains S0.
+      DatanodeDescriptor sourceDescriptor = cluster.getNamesystem()
+          .getBlockManager().getDatanodeManager()
+          .getDatanode(source.getDatanodeId());
+      assertNotNull(sourceDescriptor);
+      BPOfferService sourceService = source.getBPOfferService(blockPoolId);
+      long startedKeyUpdates = sourceService.getStartedKeyUpdateCommands();
+      long completedKeyUpdates = sourceService.getCompletedKeyUpdateCommands();
+      sourceDescriptor.setNeedKeyUpdate(true);
+      DataNodeTestUtils.triggerHeartbeat(source);
+
+      GenericTestUtils.waitFor(() -> sourceService
+          .getStartedKeyUpdateCommands() > startedKeyUpdates, 100, 120_000);
+      boolean concolicTask =
+          System.getProperty("causynth.concolic.task.id") != null;
+      if (!concolicTask) {
+        BlockTokenSecretManager sourceKeys = source
+            .getBlockPoolTokenSecretManager().get(blockPoolId);
+        int latestKeyId = latest.getCurrentKey().getKeyId();
+        GenericTestUtils.waitFor(() -> sourceService
+            .getCompletedKeyUpdateCommands() > completedKeyUpdates
+            && sourceKeys.getCurrentKey().getKeyId() == latestKeyId,
+            100, 120_000);
+      }
+
+      DatanodeInfo targetInfo = new DatanodeInfoBuilder()
+          .setNodeID(target.getDatanodeId()).build();
+      long startedDataTransfers = source.getStartedDataTransfers();
+      source.transferBlock(block, new DatanodeInfo[]{targetInfo},
+          new StorageType[]{StorageType.DISK}, new String[]{null});
+      GenericTestUtils.waitFor(() -> source.getStartedDataTransfers()
+          > startedDataTransfers, 100, 30_000);
+      if (concolicTask) {
+        // Keep the workload alive until a selected key-update region has
+        // published its result.  Fault paths need not replicate the block,
+        // but they must be allowed to leave applyKeyUpdateCommand's finally.
+        GenericTestUtils.waitFor(() -> sourceService
+            .getCompletedKeyUpdateCommands() > completedKeyUpdates,
+            100, 300_000);
+      } else {
+        GenericTestUtils.waitFor(
+            () -> target.getFSDataset().isValidBlock(block), 100, 30_000);
+      }
+    } finally {
+      if (fs != null) {
+        fs.close();
+      }
+      if (cluster != null) {
+        cluster.shutdown();
+      }
+    }
+  }
+
+  private static DataNode otherDataNode(List<DataNode> dataNodes,
+      DataNode source) throws IOException {
+    for (DataNode dataNode : dataNodes) {
+      if (dataNode != source) {
+        return dataNode;
+      }
+    }
+    throw new IOException("No replication target DataNode");
+  }
+}
