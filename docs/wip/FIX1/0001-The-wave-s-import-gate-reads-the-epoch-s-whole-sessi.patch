From cb5748c67c94233ce15ce6b51cc4887e6b4fa0bd Mon Sep 17 00:00:00 2001
From: Zhenyu Li <zhl136@ucsd.edu>
Date: Wed, 16 Sep 2026 15:36:03 -0500
Subject: [PATCH 1/3] The wave's import gate reads the epoch's whole session
 set

Invariant 1 is a SET-level rule -- exactly one session of the set states
role SEED -- and `campaign_import_wave_gate` handed it a set built by
`comm -13 sessions-before.txt <roster>`, i.e. only the sessions THAT WAVE
added.  The seed is in `sessions-before.txt` by construction, so it was
excluded from every wave gate of every case and the rule had no SEED to
find.  HDFS-17960 on 39bedd768 refused wave 0 with

    invariant 1 (CONTRACT-SPEC SS2: every session states its role in
    manifest.json): 0 of 2 sessions state role SEED []; exactly one must

(`out/hdfs-17960/schedule/iteration-0000/campaign_gaps.jsonl` line 15,
subject `epoch/sessions`, BLOCKING) over a corpus whose seed states
`"role":"SEED","obligationIds":[]` and is fine.  It is a deterministic
construction bug, not a corpus fact: the same gate over pass #8's full
three-session set reports no `epoch/sessions` row at all.

So the two questions are told apart.  WHETHER the gate runs is the wave's
own: `campaign_wave_sessions` still counts the sessions this wave added and
the `count -eq 0` early return is unchanged, because a wave that published
nothing has no row of its own to check.  WHAT the gate reads is the epoch:
`campaign_session_roster` links every session under `sessions/` into
`${gate}/sessions`, so the set is the seed plus every session published so
far -- the same set the iteration gate checks, which is the set invariant 1
is written about.  `${gate}/obligations-0000 -> ${wave_dir}` is unchanged;
nothing is copied and nothing under `sessions/` is written.

The existing wave-gate shell case now asserts both halves: the wave's own
session is gated AND the epoch's seed is in the set.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 run_engine.sh                                 | 15 ++++++++++---
 .../shell/run_engine_campaign_helpers_test.sh | 21 ++++++++++++-------
 2 files changed, 26 insertions(+), 10 deletions(-)

diff --git a/run_engine.sh b/run_engine.sh
index 2f5bdb5dd..92fb72d37 100755
--- a/run_engine.sh
+++ b/run_engine.sh
@@ -1942,8 +1942,14 @@ ${blocking} blocking"
 # ImportGateMain reads the session set of an ITERATION directory
 # ({@code <iteration>/sessions}) and invariant 10 needs that directory's
 # obligation workers, so the wave is given a directory of exactly that shape:
-# its own new sessions, and itself as the one wave of workers.  Nothing is
-# copied and nothing under sessions/ is written.
+# the EPOCH's whole session roster, and itself as the one wave of workers.
+# Nothing is copied and nothing under sessions/ is written.
+#
+# The whole roster, not the wave's own new sessions: invariant 1 is a
+# SET-level rule -- exactly one session of the set states role SEED -- and a
+# set built from the wave alone never holds the seed, so every wave of every
+# case refused "0 of N sessions state role SEED".  The wave's own sessions
+# decide only WHETHER this gate runs, not what it reads.
 campaign_import_wave_gate() {
   local iteration_dir=$1 iteration_id=$2 wave_dir=$3 sessions=$4
   local before="${wave_dir}/sessions-before.txt"
@@ -1955,7 +1961,6 @@ campaign_import_wave_gate() {
   ln -s "${wave_dir}" "${gate}/obligations-0000"
   while IFS= read -r name; do
     [[ -n "${name}" && -d "${sessions}/${name}" ]] || continue
-    ln -s "${sessions}/${name}" "${gate}/sessions/${name}"
     count=$((count + 1))
   done < <(campaign_wave_sessions "${sessions}" "${before}")
   if [[ "${count}" -eq 0 ]]; then
@@ -1966,6 +1971,10 @@ campaign_import_wave_gate() {
   fi
   campaign_log "import gate: $(basename "${wave_dir}") published \
 ${count} session(s)"
+  while IFS= read -r name; do
+    [[ -n "${name}" && -d "${sessions}/${name}" ]] || continue
+    ln -s "${sessions}/${name}" "${gate}/sessions/${name}"
+  done < <(campaign_session_roster "${sessions}")
   campaign_import_gate "${iteration_dir}" "${iteration_id}" \
     "${gate}/sessions" "${wave_dir}/import_gate.json"
 }
diff --git a/src/test/shell/run_engine_campaign_helpers_test.sh b/src/test/shell/run_engine_campaign_helpers_test.sh
index 0a19b324a..e31a9efac 100755
--- a/src/test/shell/run_engine_campaign_helpers_test.sh
+++ b/src/test/shell/run_engine_campaign_helpers_test.sh
@@ -1067,8 +1067,11 @@ grep -q "artifact=${gate_dir}/campaign_gaps.jsonl" "${gate_dir}/error.log" \
   || fail "the gate's gap file is not append-only"
 
 # The same gate over one wave's own sessions: EXPLORE calls it after the
-# wave's replays land, it reads only the sessions that wave added, and a
-# blocking violation there fails the campaign at that wave.
+# wave's replays land, and a blocking violation there fails the campaign at
+# that wave.  What the wave ADDED decides whether the gate runs; what it READS
+# is the epoch's whole roster, seed included, because invariant 1 is a
+# set-level rule (exactly one session states role SEED) and a set cut down to
+# one wave never holds the seed.
 declare -f campaign_explore | grep -q campaign_import_wave_gate \
   || fail "EXPLORE does not put its wave's sessions to the import gate"
 wave_gate="${test_tmp}/import-gate-wave"
@@ -1082,15 +1085,19 @@ campaign_session_roster "${wave_gate}/sessions" \
 mkdir -p "${wave_gate}/sessions/focus-a"
 [[ "$(campaign_wave_sessions "${wave_gate}/sessions" \
         "${wave_gate}/obligations-0000/sessions-before.txt")" == "focus-a" ]] \
-  || fail "the wave gate does not read exactly the sessions the wave added"
+  || fail "the wave gate does not count exactly the sessions the wave added"
 (
   run_java_main() {
-    # The gate is handed the wave's own session directory, and the wave
-    # itself as the one wave of obligation workers behind it.
+    # The gate is handed a session directory of its own, holding the
+    # epoch's whole roster, and the wave itself as the one wave of
+    # obligation workers behind it.
     [[ "$3" == "${wave_gate}/obligations-0000/import-gate/sessions" ]] \
       || fail "the wave gate did not name its own session set: $3"
-    [[ -d "$3/focus-a" && ! -e "$3/seed-result-0" ]] \
-      || fail "the wave gate's session set is not the wave's own"
+    [[ -d "$3/focus-a" ]] \
+      || fail "the wave gate did not gate the session its wave published"
+    [[ -d "$3/seed-result-0" ]] \
+      || fail "the wave gate left the epoch's seed out of the set it gated, \
+so invariant 1 has no SEED to find"
     [[ -f "${wave_gate}/obligations-0000/import-gate/obligations-0000/\
 OBL.a/obligation_result.jsonl" ]] \
       || fail "the wave gate hid its own obligation workers"
